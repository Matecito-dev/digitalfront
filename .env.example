# Digital Front — variables de entorno
# Copiar: cp .env.example .env  (o usar .env.vercel.example solo para Vercel)

# ── Vercel (frontend estático, npm run build:web) ─────────────────────────
DF_API_URL=https://api.example.com
DF_SITE_URL=https://play.example.com
# GitHub OAuth (registrar app en https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=https://play.example.com/auth/github/callback
# X (Twitter) OAuth 2.0 PKCE (https://developer.twitter.com)
X_CLIENT_ID=your_x_client_id_here
X_CLIENT_SECRET=your_x_client_secret_here
X_REDIRECT_URI=https://play.example.com/auth/x/callback
# ── Servidor local / VPS (npm run dev, scripts/viewer-server.ts) ───────────
# DATABASE_URL=postgresql://velis:velis@localhost:5432/velis
# REDIS_URL=redis://localhost:6379
# DF_SESSION_TTL_DAYS=30
# DF_MAX_PLAYERS=500
# DF_SHARD_ID=valle-bruma
# DF_TILE_CACHE=/srv/avps/shared/tile-cache
# DF_CORS_ORIGINS=https://play.example.com,https://example.com
# DF_API_ONLY=1
# NODE_ENV=production
# HOST=127.0.0.1
# PORT=3333

# Arranque local:
#   npm run infra:up && npm run db:migrate && npm run dev
