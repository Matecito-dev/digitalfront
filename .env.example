# Digital Front — variables de entorno
# Copiar: cp .env.example .env  (o usar .env.vercel.example solo para Vercel)

# ── Vercel (frontend estático, npm run build:web) ─────────────────────────
# Pegar en Vercel → Settings → Environment Variables (Production + Preview):
DF_API_URL=https://api.gamedevforge.com
DF_SITE_URL=https://play.gamedevforge.com
# IDs públicos (Vercel los inyecta en el build → window.DF_OAUTH):
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_REDIRECT_URI=https://play.gamedevforge.com/auth/github/callback
X_CLIENT_ID=your_x_client_id_here
X_REDIRECT_URI=https://play.gamedevforge.com/auth/x/callback
# ── VPS (backend — intercambio OAuth + secretos) ───────────────────────────
# Copiar a .env local y: bash scripts/sync-vps-env.sh
GITHUB_CLIENT_SECRET=your_github_client_secret_here
X_CLIENT_SECRET=your_x_client_secret_here
# ── Servidor local / VPS (npm run dev, scripts/viewer-server.ts) ───────────
# DATABASE_URL=postgresql://velis:velis@localhost:5432/velis
# REDIS_URL=redis://localhost:6379
# DF_SESSION_TTL_DAYS=30
# DF_MAX_PLAYERS=500
# DF_SHARD_ID=valle-bruma
# DF_TILE_CACHE=/srv/avps/shared/tile-cache
# DF_CORS_ORIGINS=https://play.example.com,https://example.com
# DF_API_ONLY=1
# NODE_ENV=production
# HOST=127.0.0.1
# PORT=3333

# Arranque local:
#   npm run infra:up && npm run db:migrate && npm run dev
