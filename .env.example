# Velis MMO — variables de entorno (copiar a .env)
#
# Arranque local:
#   npm run infra:up      # Postgres :5432 + Redis :6379
#   npm run db:migrate    # schema profiles
#   npm run dev           # juego en http://localhost:3333

# PostgreSQL (docker compose)
DATABASE_URL=postgresql://velis:velis@localhost:5432/velis

# Redis (docker compose)
REDIS_URL=redis://localhost:6379

# Sesión invitado (TTL en Redis)
VELIS_SESSION_TTL_DAYS=30

# Límites MVP
VELIS_MAX_PLAYERS=500
VELIS_SHARD_ID=valle-bruma
