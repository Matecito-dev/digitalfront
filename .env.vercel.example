# Pegar en Vercel → Settings → Environment Variables
# Marcar: Production, Preview y Development
#
# O importar con CLI (desde la raíz del repo, tras vercel link):
#   export $(grep -v '^#' .env.vercel.example | xargs)  # no recomendado en prod
#   vercel env add DF_API_URL production <<< "https://api.gamedevforge.com"
#   vercel env add DF_SITE_URL production <<< "https://play.gamedevforge.com"

DF_API_URL=https://api.gamedevforge.com
DF_SITE_URL=https://play.gamedevforge.com
